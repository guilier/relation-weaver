{
  "name": "relation-weaver",
  "version": "3.0.1",
  "description": "An Obsidian plugin for managing characters, factions, relationships, and timelines in novels, TTRPG campaigns, and worldbuilding projects.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "novel-writing",
    "ttrpg",
    "worldbuilding",
    "character-management",
    "relationship-mapping",
    "timeline"
  ],
  "author": "guilier",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
